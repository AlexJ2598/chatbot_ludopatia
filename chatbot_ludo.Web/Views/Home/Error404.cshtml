@{
    ViewData["Title"] = "Error 404 - Page Not Found";
}

<div class="container text-center" style="margin-top: 50px;">
    <div class="row">
        <div class="col-md-12">
            <img src="~/images/herizo_not_found.png" alt="Page Not Found" class="img-fluid" style="max-width: 300px;" />
            <h1 class="display-4" style="margin-top: 20px;">Oops! Page Not Found</h1>
            <p class="lead" style="margin-top: 20px;">
                It seems like the page you're looking for doesn't exist.
                It may have been moved, deleted, or the URL is incorrect.
            </p>
            <a href="/" class="btn btn-primary btn-lg" style="margin-top: 20px;">Go Back Home</a>
        </div>
    </div>
</div>

